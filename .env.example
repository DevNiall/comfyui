# Base configuration for ComfyUI CDK deployment.
# Precedence is: shell env > .env.<AWS_PROFILE> > .env > defaults in app.py.

# AWS profile used by Makefile and for selecting profile-specific env file.
# AWS_PROFILE=default

# CDK target environment (required)
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=eu-west-2

# Optional stack settings
INSTANCE_TYPE=g6.2xlarge
FALLBACK_INSTANCE_TYPES=g4dn.2xlarge,g6.xlarge,g5.2xlarge,g5.xlarge,g4dn.xlarge
SPOT_MAX_PRICE=1.20
DATA_VOLUME_SIZE_GB=500
SNAPSHOT_INTERVAL_HOURS=12
SNAPSHOT_RETAIN_COUNT=3
HF_TOKEN_PARAM=/comfyui/hf-token
VPC_ID=vpc-xxxxxxxxxxxxxxxxx

# Optional Makefile overrides
STACK_NAME=ComfyUISimpleStack
LOCAL_PORT=8181
REMOTE_PORT=8181
CONTAINER_NAME=comfyui
